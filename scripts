library(randomForest)
library(caret)
library(broom)
library(pdp)
library(ggplot2)
library(dplyr)
library(tidyr)

# -------------------------------------------------------------
# DATA FOR MODELLING
# -------------------------------------------------------------
ml_df <- Filled %>%
  select(DateTime, NEP, Rg_f, Tair_f, VPD_f, phase) %>%
  drop_na()

train_idx <- createDataPartition(ml_df$NEP, p = 0.8, list = FALSE)
train <- ml_df[train_idx, ]
test  <- ml_df[-train_idx, ]

# -------------------------------------------------------------
# MODELS
# -------------------------------------------------------------
lm_mod <- lm(NEP ~ Rg_f + Tair_f + VPD_f + phase, data = train)
rf_mod <- randomForest(
  NEP ~ Rg_f + Tair_f + VPD_f + phase,
  data = train,
  ntree = 800,
  importance = TRUE
)

# -------------------------------------------------------------
# PREDICTIONS
# -------------------------------------------------------------
pred_df <- tibble(
  Observed = test$NEP,
  LM = predict(lm_mod, test),
  RF = predict(rf_mod, test)
)

lm_r2 <- R2(pred_df$LM, pred_df$Observed)
rf_r2 <- R2(pred_df$RF, pred_df$Observed)

# =============================================================
# 1. OBSERVED vs PREDICTED — LINEAR MODEL
# =============================================================

p_lm <- ggplot(pred_df, aes(Observed, LM)) +
  
  # Reference axes (dotted)
  geom_hline(yintercept = 0, linetype = "dotted", colour = "grey40") +
  geom_vline(xintercept = 0, linetype = "dotted", colour = "grey40") +
  
  geom_point(alpha = 0.6, colour = "#4575B4") +
  geom_abline(slope = 1, intercept = 0, linetype = "dashed") +
  labs(
    title = "Observed vs Predicted NEP — Linear Model",
    subtitle = paste("Test R² =", round(lm_r2, 2)),
    x = "Observed NEP",
    y = "Predicted NEP"
  )

ggsave(
  "Observed_vs_Predicted_NEP_LM.png",
  p_lm,
  width = 6,
  height = 5,
  dpi = 150
)


# =============================================================
# 2. OBSERVED vs PREDICTED — RANDOM FOREST
# =============================================================

p_rf <- ggplot(pred_df, aes(Observed, RF)) +
  
  # Reference axes (dotted)
  geom_hline(yintercept = 0, linetype = "dotted", colour = "grey40") +
  geom_vline(xintercept = 0, linetype = "dotted", colour = "grey40") +
  
  geom_point(alpha = 0.6, colour = "#D73027") +
  geom_abline(slope = 1, intercept = 0, linetype = "dashed") +
  
  labs(
    title = "Observed vs Predicted NEP — Random Forest",
    subtitle = paste("Test R² =", round(rf_r2, 2)),
    x = "Observed NEP",
    y = "Predicted NEP"
  )

ggsave(
  "Observed_vs_Predicted_NEP_RF.png",
  p_rf,
  width = 6,
  height = 5,
  dpi = 150
)


# =============================================================
# 3. LINEAR MODEL SENSITIVITY (NORMALISED COEFFICIENTS)
# =============================================================

train_lm_norm <- train %>%
  mutate(
    Rg_f   = scale(Rg_f),
    Tair_f = scale(Tair_f),
    VPD_f  = scale(VPD_f)
  )

lm_norm <- lm(NEP ~ Rg_f + Tair_f + VPD_f + phase, data = train_lm_norm)

lm_sens <- tidy(lm_norm) %>%
