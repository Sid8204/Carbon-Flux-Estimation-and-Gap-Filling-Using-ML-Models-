# 5. DIURNAL SENSITIVITY BY GROWTH STAGE — LM AND RF (SEPARATE)
# =============================================================

library(dplyr)
library(ggplot2)
library(randomForest)
library(lubridate)
library(tidyr)

# -------------------------------------------------------------
# Diurnal aggregation
# -------------------------------------------------------------
diurnal_df <- ml_df %>%
  mutate(Hour = hour(DateTime)) %>%
  group_by(phase, Hour) %>%
  summarise(
    NEP  = mean(NEP, na.rm = TRUE),
    Rg   = mean(Rg_f, na.rm = TRUE),
    Tair = mean(Tair_f, na.rm = TRUE),
    VPD  = mean(VPD_f, na.rm = TRUE),
    .groups = "drop"
  )

# -------------------------------------------------------------
# Fit models per growth stage
# -------------------------------------------------------------
fit_phase_models <- function(df) {
  
  df <- df %>%
    mutate(
      Rg   = scale(Rg),
      Tair = scale(Tair),
      VPD  = scale(VPD)
    )
  
  lm_m <- lm(NEP ~ Rg + Tair + VPD, data = df)
  rf_m <- randomForest(NEP ~ Rg + Tair + VPD, data = df, ntree = 500)
  
  tibble(
    Variable = c("Rg","Tair","VPD"),
    LM = coef(lm_m)[c("Rg","Tair","VPD")],
    RF = importance(rf_m)[c("Rg","Tair","VPD"),"IncNodePurity"]
  )
}

sens_diurnal <- diurnal_df %>%
  group_by(phase) %>%
  group_modify(~ fit_phase_models(.x)) %>%
  ungroup()
# =============================================================
# A. LINEAR MODEL — DIURNAL SENSITIVITY
# =============================================================

p_lm_diurnal <- ggplot(
  sens_diurnal,
  aes(Variable, LM)
) +
  geom_col(fill = "#4575B4", width = 0.6) +
  facet_wrap(~ phase, scales = "free_y") +
  labs(
    title = "Diurnal NEP Sensitivity by Growth Stage — Linear Model",
    y = "Linear sensitivity (slope)",
    x = "Driver"
  )

ggsave(
  "Diurnal_Sensitivity_LM_By_Phase.png",
  p_lm_diurnal,
  width = 12,
  height = 6,
  dpi = 150
)

# =============================================================
# B. RANDOM FOREST — DIURNAL SENSITIVITY (RAW IMPORTANCE)
# =============================================================
library(ggh4x)

sens_rf <- sens_diurnal %>%
  select(phase, Variable, RF)

# ---- derive per-phase limits ----
ylims_tbl <- sens_rf %>%
  group_by(phase) %>%
  summarise(
    ymin = floor(min(RF, na.rm = TRUE) * 0.8),
    ymax = ceiling(max(RF, na.rm = TRUE) * 1.05),
    .groups = "drop"
  )

# ---- create named list for facet-wise limits ----
y_scales <- lapply(
  split(ylims_tbl, ylims_tbl$phase),
  function(lim) scale_y_continuous(limits = c(lim$ymin, lim$ymax))
)

p_rf_diurnal <- ggplot(
  sens_rf,
  aes(Variable, RF)
) +
  geom_col(fill = "#D73027", width = 0.6) +
  ggh4x::facet_wrap2(~ phase, scales = "free_y") +
  ggh4x::facetted_pos_scales(
    y = y_scales
  ) +
  labs(
    title = "Diurnal NEP Sensitivity by Growth Stage — Random Forest",
    y = "Variable importance (IncNodePurity)",
    x = "Driver"
  )

ggsave(
  "Diurnal_Sensitivity_RF_By_Phase.png",
  p_rf_diurnal,
  width = 12,
  height = 6,
  dpi = 150
)








