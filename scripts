# =============================================================
# CO2 FLUX ANALYSIS – PADDY SEASON (NEP, DT + NT, FULL PIPELINE)
# =============================================================

library(tidyverse)
library(lubridate)
library(REddyProc)
library(ggplot2)
library(randomForest)
library(caret)
library(broom)
library(zoo)
library(reshape2)
library(patchwork)
windowsFonts(Times = windowsFont("Times New Roman"))

theme_set(
  theme_bw(base_size = 14, base_family = "Times") +
    theme(
      plot.title = element_text(size = 14, face = "bold"),
      plot.subtitle = element_text(size = 14),
      axis.title = element_text(size = 14),
      axis.text = element_text(size = 14),
      legend.title = element_text(size = 14),
      legend.text = element_text(size = 14),
      strip.text = element_text(size = 14)
    )
)
# =============================================================
# USER SETTINGS
# =============================================================

infile <- "data/workfile.csv"
output_dir <- "outputs"

start_dt <- as.POSIXct("2024-07-20 00:00:00", tz = "UTC")
end_dt   <- as.POSIXct("2024-11-15 23:59:59", tz = "UTC")

# ---------------- PHENOLOGY ----------------
pheno_tbl <- tibble(
  phase = factor(
    c("Transplanting","Vegetative","Reproductive","Maturity"),
    levels = c("Transplanting","Vegetative","Reproductive","Maturity")
  ),
  start = as.Date(c("2024-07-20","2024-08-11","2024-09-16","2024-10-16")),
  end   = as.Date(c("2024-08-10","2024-09-15","2024-10-15","2024-11-16"))
)

# =============================================================
# STEP 1: READ + TRUE NEE
# =============================================================

df <- read_csv(infile, show_col_types = FALSE) %>%
  mutate(
    Date = dmy(date),
    DateTime = as.POSIXct(paste(Date, time), tz = "UTC"),
    NEE = ifelse(qc_co2_flux == 0, co2_flux + co2_strg, NA_real_),
    Tair = Tair - 273.15,
    VPD  = VPD / 100,
    Year = year(DateTime),
    DoY  = yday(DateTime),
    Hour = hour(DateTime) + minute(DateTime)/60
  ) %>%
  filter(DateTime >= start_dt & DateTime <= end_dt)

# ---------------- Physical filters ----------------
df <- df %>%
  mutate(
    NEE   = ifelse(NEE < -50 | NEE > 50, NA, NEE),
    Rg    = ifelse(Rg < 0 | Rg > 1200, NA, Rg),
    VPD   = ifelse(VPD <= 0, NA, VPD),
    Tair  = ifelse(Tair < -10 | Tair > 60, NA, Tair),
    Ustar = ifelse(Ustar < 0 | Ustar > 3, NA, Ustar)
  )


# =============================================================
# STEP 2: REGULAR TIME GRID
# =============================================================

data_full <- tibble(
  DateTime = seq(min(df$DateTime), max(df$DateTime), by = "30 min")
) %>%
  left_join(df, by = "DateTime") %>%
  mutate(
    Year = year(DateTime),
    DoY  = yday(DateTime),
    Hour = hour(DateTime) + minute(DateTime)/60
  ) %>%
  select(DateTime, Year, DoY, Hour, NEE, Rg, Tair, VPD, Ustar)


# =============================================================
# STEP 3: REddyProc (CORRECT ORDER)
# =============================================================

EProc <- sEddyProc$new(
  "PaddySite",
  data_full,
  ColNames = c("Year","DoY","Hour","NEE","Rg","Tair","VPD","Ustar"),
  DTS = 48
)

EProc$sSetLocationInfo(22.31, 87.31, 5)

# ---- GAP FILLING ----
EProc$sEstimateUstarScenarios(probs = c(0.05, 0.5, 0.95))
EProc$sMDSGapFillUStarScens("NEE")
EProc$sMDSGapFill("Rg",   FillAll = TRUE)
EProc$sMDSGapFill("VPD",  FillAll = TRUE)
EProc$sMDSGapFill("Tair", FillAll = TRUE)

# ---- PARTITIONING ----
EProc$sGLFluxPartitionUStarScens()
EProc$sMRFluxPartitionUStarScens(debug = list(fixedE0 = -120))
EProc$sPlotNEEVersusUStarForSeason()
# =============================================================
# EXPORT + NEP
# =============================================================

Filled <- EProc$sExportResults() %>%
  mutate(
    DateTime = data_full$DateTime,
    Date     = as.Date(DateTime),
    NEP      = -NEE_U50_f
  ) %>%
  left_join(pheno_tbl, by = join_by(Date >= start, Date <= end)) %>%
  mutate(phase = factor(phase))

# ---- derive NT GPP if available ----
if ("Reco_NT_U50" %in% names(Filled)) {
  Filled <- Filled %>%
    mutate(GPP_NT_U50 = Reco_NT_U50 - NEE_U50_f)
}

# ---- day/night flag ----
Filled <- Filled %>%
  mutate(DayFlag = ifelse(Rg_f > 10, "Day", "Night"))

write_csv(
  Filled,
  output_dir
)


