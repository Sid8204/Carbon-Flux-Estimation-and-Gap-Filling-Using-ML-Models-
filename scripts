add_pheno_shade <- function() {
  geom_rect(
    data = pheno_tbl,
    aes(xmin = as.POSIXct(start), xmax = as.POSIXct(end),
        ymin = -Inf, ymax = Inf, fill = phase),
    inherit.aes = FALSE,
    alpha = 0.18
  )
}

plot_ts <- function(df, var, title) {
  ggplot(df, aes(DateTime, .data[[var]])) +
    add_pheno_shade() +
    geom_line(colour = "#1f78b4", linewidth = 0.6) +
    scale_fill_brewer(
      palette = "Set2",
      name = "Phase",
      limits = c("Transplanting","Vegetative","Reproductive","Maturity")
    ) +
    labs(title = title, x = "Date", y = var)
}

