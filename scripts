# =============================================================
# 4. RANDOM FOREST DRIVER IMPORTANCE (NORMALISED BAR)
# =============================================================

train_rf_norm <- train %>%
  mutate(
    Rg_f   = scale(Rg_f),
    Tair_f = scale(Tair_f),
    VPD_f  = scale(VPD_f)
  )

rf_norm <- randomForest(
