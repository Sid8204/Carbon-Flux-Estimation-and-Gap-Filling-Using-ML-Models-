library(ggplot2)
library(dplyr)

# -------------------------------------------------------------
# Helper function: functional relationship plot
# -------------------------------------------------------------
plot_func <- function(df, x, y, title, filter_rg = FALSE) {
  
  plot_df <- df
  
  if (filter_rg && x == "Rg") {
    plot_df <- plot_df %>% filter(Rg > 10)
  }
  
  ggplot(plot_df, aes(.data[[x]], .data[[y]])) +
    geom_point(alpha = 0.4, colour = "#1B7837") +
    geom_smooth(method = "loess", se = TRUE, colour = "black") +
    labs(
      title = title,
      x = x,
      y = y
    )
}

